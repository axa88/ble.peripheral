	std::map<uint8_t, uint32_t> restartTimerGenerations_;
	std::set<uint8_t> pendingRestartInstances_;
	std::map<uint8_t, uint32_t> restartGenerations_;
	constexpr uint32_t kRestartDelayMs = 5000;
#if CONFIG_BT_NIMBLE_EXT_ADV
