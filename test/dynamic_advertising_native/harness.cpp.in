#else
	constexpr size_t kDeferredAdvertisingSlots = 1;
#endif
	struct DeferredStopCallback
	{
		bool pending = false;
		int reason = 0;
		bool activeAfterCallback = false;
		bool restartEligible = false;
		bool clearDirected = false;
		uint32_t intentEpoch = 0;
	};
	struct DeferredCallbacks
	{
		bool connectionEstablished = false;
		uint32_t connectionIntentEpoch = 0;
		std::array<DeferredStopCallback, kDeferredAdvertisingSlots> advertisingStopped{};
		std::array<bool, kDeferredAdvertisingSlots> restartTimerPending{};
		std::array<uint32_t, kDeferredAdvertisingSlots> restartTimerGenerations{};
	};
	std::array<std::atomic<uint32_t>, kDeferredAdvertisingSlots> advertisingIntentEpochs_{};
	std::mutex deferredCallbacksMutex_;
	DeferredCallbacks deferredCallbacks_;
	ble_npl_event deferredCallbacksEvent_{};
	bool deferredCallbacksEventInitialized_ = false;
	bool deferredCallbacksEventQueued_ = false;
	std::map<uint8_t, uint32_t> stopRequestGenerations_;
	std::map<uint8_t, uint32_t> stopCompletionGenerations_;
	uint32_t nextStopGeneration_ = 0;
	constexpr uint32_t kStopCompletionTimeoutMs = 5000;
	std::vector<uint8_t> appliedIds;
	std::vector<uint8_t> startedIds;
	int startCalls = 0;
	int applyCalls = 0;
	int failApplyId = -1;
	bool startReturns = true;
	bool startActivates = true;
	bool startInstanceReturns = true;
	void deferredAdvertisingEventHandler(ble_npl_event* event);
	void deferConnectionEstablished();
#if CONFIG_BT_NIMBLE_EXT_ADV
	void deferAdvertisingStopped(uint8_t instanceId, int reason, bool activeAfterCallback, bool restartEligible, bool clearDirected);
	void processAdvertisingStopped(uint8_t instanceId, int reason, bool activeAfterCallback, bool restartEligible, bool clearDirected);
#endif
	void deferRestartTimer(uint8_t instanceId, uint32_t generation);
	void processRestartTimer(uint8_t instanceId, uint32_t generation);
	void queueDeferredAdvertisingEventIfReady();
#if CONFIG_BT_NIMBLE_EXT_ADV
	NimBLEExtAdvertising* Adv() { return advertisingObject(); }
#else
	NimBLEAdvertising* Adv() { return advertisingObject(); }
	void restoreLegacyOrdinaryLocked() {}
#endif
	void restartTimerCallback(TimerHandle_t timer) { (void)timer; }
	bool startInstanceLocked(uint8_t instanceId)
	{
		++startCalls;
		startedIds.push_back(instanceId);
		if (startInstanceReturns) hostActive[instanceId] = true;
#if !CONFIG_BT_NIMBLE_EXT_ADV
		if (instanceId == 0 && startInstanceReturns) legacyActive = true;
#endif
		return startInstanceReturns;
	}
	void clearDirectedStateLocked()
	{
		directedActive_ = false;
		directedInstance_.reset();
	}

	@@ADVERTISING_HELPERS@@

	static void resetAdvertisingState()
	{
		for (auto [id, timer] : restartTimers_)
		{
			(void)id;
			xTimerStop(timer, 0);
			xTimerDelete(timer, 0);
		}
		restartTimers_.clear();
		restartTimerGenerations_.clear();
		configs_.clear();
		directedActive_ = false;
		directedInstance_.reset();
		pendingRestartInstances_.clear();
		restartGenerations_.clear();
		stopRequestGenerations_.clear();
		stopCompletionGenerations_.clear();
		nextStopGeneration_ = 0;
		for (auto& epoch : advertisingIntentEpochs_) epoch.store(0);
		{
			std::lock_guard<std::mutex> lock(deferredCallbacksMutex_);
			deferredCallbacks_ = {};
			deferredCallbacksEvent_ = {};
			deferredCallbacksEventInitialized_ = false;
			deferredCallbacksEventQueued_ = false;
		}
		nimbleEvents.clear();
		hostActive.fill(false);
		wrapperActive.fill(false);
		legacyActive = false;
		stopSucceeds = true;
		stopCalls = 0;
		appliedIds.clear();
		startedIds.clear();
		startCalls = 0;
		applyCalls = 0;
		failApplyId = -1;
		startReturns = true;
		startActivates = true;
		startInstanceReturns = true;
		failTimerCreate = false;
		failTimerStart = false;
		FixtureGatt::ready = true;
		DynamicGatt::state = DynamicGatt::State::Ready;
		Serial.input.clear();
	}
}

