namespace FixtureGatt
{
	static bool ready = true;
	inline bool Ready() { return ready; }
}
namespace DynamicGatt
{
	enum class State { Ready, Applying, RecoveryRequired };
	static std::atomic<State> state{ State::Ready };
	static std::mutex entryMutex;
	static std::atomic<unsigned> entryCount{ 0 };
	inline State CurrentState() { return state.load(); }
	class Entry
	{
	public:
		explicit Entry(bool requireReady = true)
		{
			if ((!requireReady || CurrentState() == State::Ready) && entryMutex.try_lock())
			{
				held_ = true;
				++entryCount;
			}
		}
		~Entry()
		{
			if (!held_) return;
			--entryCount;
			entryMutex.unlock();
			if (CurrentState() == State::Ready) Advertising::DrainDeferredCallbacks();
		}
		explicit operator bool() const { return held_; }
	private:
		bool held_ = false;
	};
	inline bool IsEntryHeld() { return entryCount.load() != 0; }
}
