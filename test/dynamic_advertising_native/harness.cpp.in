static Advertising::InstanceConfig config(uint8_t id)
{
	Advertising::InstanceConfig result;
	result.id = id;
	result.restartAfterConnection = true;
	result.discoverable = DiscoverableMode::General;
	result.mode = AdvertisementMode::Ordinary;
	return result;
}
static void testHostTruthCaptureAndStop()
{
	resetAdvertisingState();
	configs_[0] = config(0);
#if CONFIG_BT_NIMBLE_EXT_ADV
	hostActive[0] = true;
	wrapperActive[0] = false;
#else
	legacyActive = true;
#endif
	Advertising::RebuildSnapshot snapshot;
	assert(Advertising::CaptureForRebuild(snapshot));
	assert(snapshot.configs.size() == 1);
	assert(snapshot.active.size() == 1 && snapshot.active[0] == 0);
	auto stopped = Advertising::StopAll();
	assert(stopped.stopped == 1 && stopped.failed == 0);
	assert(stopCalls == 1);
#if CONFIG_BT_NIMBLE_EXT_ADV
	assert(!hostActive[0]);
#else
	assert(!legacyActive);
#endif
}
static void testRestoreSuccessAndOrder()
{
	resetAdvertisingState();
	configs_[0] = config(0);
#if CONFIG_BT_NIMBLE_EXT_ADV
	configs_[1] = config(1);
	hostActive[0] = true;
	wrapperActive[0] = false;
	pendingRestartInstances_.insert(1);
	Advertising::RebuildSnapshot snapshot;
	assert(Advertising::CaptureForRebuild(snapshot));
	assert(snapshot.active.size() == 1 && snapshot.active[0] == 0);
	assert(snapshot.pending.size() == 1 && snapshot.pending[0] == 1);
	hostActive.fill(false);
	wrapperActive.fill(false);
	pendingRestartInstances_.clear();
	restartGenerations_.clear();
	assert(Advertising::RestoreAfterRebuild(snapshot));
	assert(appliedIds.size() == 2 && appliedIds[0] == 0 && appliedIds[1] == 1);
	assert(startedIds.size() == 1 && startedIds[0] == 0);
	assert(hostActive[0]);
	assert(pendingRestartInstances_.count(1) == 1);
	assert(restartTimers_.count(1) == 1 && restartTimers_[1]->started);
#else
	legacyActive = true;
	Advertising::RebuildSnapshot snapshot;
	assert(Advertising::CaptureForRebuild(snapshot));
	assert(snapshot.active.size() == 1 && snapshot.active[0] == 0);
	legacyActive = false;
	assert(Advertising::RestoreAfterRebuild(snapshot));
	assert(appliedIds.size() == 1 && appliedIds[0] == 0);
	assert(startedIds.size() == 1 && startedIds[0] == 0);
	assert(legacyActive);
#endif
}
static void testRestoreFailures()
{
	resetAdvertisingState();
	configs_[0] = config(0);
	Advertising::RebuildSnapshot activeSnapshot;
	activeSnapshot.configs = { config(0) };
	activeSnapshot.active = { 0 };
	failApplyId = 0;
	assert(!Advertising::RestoreAfterRebuild(activeSnapshot));
	assert(startedIds.empty());
	assert(pendingRestartInstances_.count(0) == 0);

	resetAdvertisingState();
	configs_[0] = config(0);
	activeSnapshot.configs = { config(0) };
	activeSnapshot.active = { 0 };
	startActivates = false;
	assert(!Advertising::RestoreAfterRebuild(activeSnapshot));
	assert(startedIds.size() == 1 && !hostActive[0]);

	for (bool failStart : { false, true })
	{
		resetAdvertisingState();
		configs_[0] = config(0);
		Advertising::RebuildSnapshot pendingSnapshot;
		pendingSnapshot.configs = { config(0) };
		pendingSnapshot.pending = { 0 };
		if (failStart) failTimerStart = true;
		else failTimerCreate = true;
		assert(!Advertising::RestoreAfterRebuild(pendingSnapshot));
		assert(pendingRestartInstances_.count(0) == 1);
		assert(restartTimers_.count(0) == 0);
		assert(liveTimers == 0);
	}
}
static void testDeferredApplyingPersistence()
{
	resetAdvertisingState();
	configs_[0] = config(0);
	DynamicGatt::state = DynamicGatt::State::Applying;
#if CONFIG_BT_NIMBLE_EXT_ADV
	Advertising::OnAdvertisingStopped(0, 0);
	assert(deferredCallbacks_.advertisingStopped[0].pending);
#else
	Advertising::OnConnectionEstablished();
	assert(deferredCallbacks_.connectionEstablished);
#endif
	assert(nimbleEvents.empty());

	DynamicGatt::state = DynamicGatt::State::Ready;
	Advertising::DrainDeferredCallbacks();
	assert(nimbleEvents.size() == 1);
	DynamicGatt::state = DynamicGatt::State::Applying;
	runOneNimbleEvent();
	assert(nimbleEvents.empty());
#if CONFIG_BT_NIMBLE_EXT_ADV
	assert(deferredCallbacks_.advertisingStopped[0].pending);
#else
	assert(deferredCallbacks_.connectionEstablished);
#endif

	DynamicGatt::state = DynamicGatt::State::Ready;
	Advertising::DrainDeferredCallbacks();
	assert(nimbleEvents.size() == 1);
	runOneNimbleEvent();
	assert(pendingRestartInstances_.count(0) == 1);
	assert(restartTimers_.count(0) == 1 && restartTimers_[0]->started);
}
static void testReadyLeaseCollisionRequeues()
{
	resetAdvertisingState();
	configs_[0] = config(0);
	{
		DynamicGatt::Entry serialMutation;
		assert(serialMutation);
#if CONFIG_BT_NIMBLE_EXT_ADV
		Advertising::OnAdvertisingStopped(0, 0);
#else
		Advertising::OnConnectionEstablished();
#endif
		assert(nimbleEvents.size() == 1);
		runOneNimbleEvent();
		assert(nimbleEvents.size() == 1);
#if CONFIG_BT_NIMBLE_EXT_ADV
		assert(deferredCallbacks_.advertisingStopped[0].pending);
#else
		assert(deferredCallbacks_.connectionEstablished);
#endif
	}
	assert(nimbleEvents.size() == 1);
	runOneNimbleEvent();
	assert(pendingRestartInstances_.count(0) == 1);
	assert(restartTimers_.count(0) == 1 && restartTimers_[0]->started);
}
static void testStaleDeferredIntentAndTimerGeneration()
{
	resetAdvertisingState();
	configs_[0] = config(0);
	{
		DynamicGatt::Entry serialMutation;
		assert(serialMutation);
#if CONFIG_BT_NIMBLE_EXT_ADV
		Advertising::OnAdvertisingStopped(0, 0);
		assert(nimbleEvents.size() == 1);
#else
		Advertising::OnConnectionEstablished();
		assert(nimbleEvents.size() == 1);
#endif
		{
			std::lock_guard<std::mutex> lock(configMutex_);
			cancelRestartLocked(0, "manual stop invalidates deferred callback");
		}
	}
	runOneNimbleEvent();
	assert(pendingRestartInstances_.count(0) == 0);
	assert(restartTimers_.count(0) == 0);

	resetAdvertisingState();
	configs_[0] = config(0);
	pendingRestartInstances_.insert(0);
	restartGenerations_[0] = 8;
	DynamicGatt::state = DynamicGatt::State::Applying;
	@@TRY_RESTART_STALE_TEST@@
	DynamicGatt::state = DynamicGatt::State::Ready;
	Advertising::DrainDeferredCallbacks();
	runOneNimbleEvent();
	assert(startCalls == 0);
	assert(pendingRestartInstances_.count(0) == 1);

	resetAdvertisingState();
	configs_[0] = config(0);
	pendingRestartInstances_.insert(0);
	restartGenerations_[0] = 8;
	DynamicGatt::state = DynamicGatt::State::Applying;
	@@TRY_RESTART_CURRENT_TEST@@
	DynamicGatt::state = DynamicGatt::State::Ready;
	Advertising::DrainDeferredCallbacks();
	runOneNimbleEvent();
	assert(startCalls == 1 && hostActive[0]);
	assert(pendingRestartInstances_.count(0) == 0);
}
static void testSerialMenuAdmission()
{
	using ConsoleCommand::Group;
	ProcessMenu::handlerCalls = 0;
	ProcessMenu::handlerSawEntry = false;
	auto invoke = [](char key, Group group, DynamicGatt::State state)
	{
		ConsoleCommand::descriptor.group = group;
		ConsoleCommand::descriptor.description = "test";
		ConsoleCommand::descriptor.handler = testCommandHandler;
		ConsoleCommand::expectedKey = key;
		DynamicGatt::state = state;
		Serial.input.clear();
		Serial.feed(static_cast<char>(std::tolower(static_cast<unsigned char>(key))));
		ProcessMenu::consoleMode = ConsoleMode::Config;
		ProcessMenu::handleConfigInput();
	};
	invoke('A', Group::Advertising, DynamicGatt::State::Applying);
	assert(ProcessMenu::handlerCalls == 0);
	invoke('Q', Group::Advertising, DynamicGatt::State::Applying);
	assert(ProcessMenu::handlerCalls == 1 && !ProcessMenu::handlerSawEntry);
	invoke('W', Group::Advertising, DynamicGatt::State::Applying);
	assert(ProcessMenu::handlerCalls == 2 && !ProcessMenu::handlerSawEntry);
	invoke('D', Group::Security, DynamicGatt::State::Applying);
	assert(ProcessMenu::handlerCalls == 2);
	invoke('S', Group::Security, DynamicGatt::State::Applying);
	assert(ProcessMenu::handlerCalls == 2);
	invoke('A', Group::Advertising, DynamicGatt::State::Ready);
	assert(ProcessMenu::handlerCalls == 3 && ProcessMenu::handlerSawEntry);
	invoke('D', Group::Security, DynamicGatt::State::Ready);
	assert(ProcessMenu::handlerCalls == 4 && ProcessMenu::handlerSawEntry);
	invoke('S', Group::Security, DynamicGatt::State::Ready);
	assert(ProcessMenu::handlerCalls == 5 && ProcessMenu::handlerSawEntry);
}
static void testBufferedSubmissionAdmission()
{
	const char interval[] = "250";
	ProcessMenu::consoleMode = ConsoleMode::SetAdvInterval;
	DynamicGatt::state = DynamicGatt::State::Applying;
	intervalCalls = 0;
	ProcessInput::submitInterval(interval, 0, 3, 3);
	assert(ProcessMenu::consoleMode == ConsoleMode::Config && intervalCalls == 0);

	ProcessMenu::consoleMode = ConsoleMode::SetAdvInterval;
	DynamicGatt::state = DynamicGatt::State::Ready;
	ProcessInput::submitInterval(interval, 0, 3, 3);
	assert(intervalCalls == 1 && ProcessMenu::consoleMode == ConsoleMode::Config);

	const char bond[] = "0";
	ProcessMenu::consoleMode = ConsoleMode::SelectBondTarget;
	DynamicGatt::state = DynamicGatt::State::Applying;
	ProcessMenu::selectedBondCalls = 0;
	ProcessInput::submitBondTarget(bond, 0, 1, 1);
	assert(ProcessMenu::consoleMode == ConsoleMode::Config && ProcessMenu::selectedBondCalls == 0);
	ProcessMenu::consoleMode = ConsoleMode::SelectBondTarget;
	DynamicGatt::state = DynamicGatt::State::Ready;
	ProcessInput::submitBondTarget(bond, 0, 1, 1);
	assert(ProcessMenu::selectedBondCalls == 1 && ProcessMenu::selectedBondIndex == 0);

#if CONFIG_BT_NIMBLE_EXT_ADV
	const char add[] = "1 demo";
	ProcessMenu::consoleMode = ConsoleMode::AddAdvInstance;
	DynamicGatt::state = DynamicGatt::State::Applying;
	addInstanceCalls = 0;
	ProcessInput::submitAddInstance(add, 0, 6, 6);
	assert(ProcessMenu::consoleMode == ConsoleMode::Config && addInstanceCalls == 0);
	ProcessMenu::consoleMode = ConsoleMode::AddAdvInstance;
	DynamicGatt::state = DynamicGatt::State::Ready;
	ProcessInput::submitAddInstance(add, 0, 6, 6);
	assert(ProcessMenu::consoleMode == ConsoleMode::Config && addInstanceCalls == 1);
#endif
}
int main()
{
	testHostTruthCaptureAndStop();
	testRestoreSuccessAndOrder();
	testRestoreFailures();
	testDeferredApplyingPersistence();
	testReadyLeaseCollisionRequeues();
	testStaleDeferredIntentAndTimerGeneration();
	testSerialMenuAdmission();
	testBufferedSubmissionAdmission();
#if CONFIG_BT_NIMBLE_EXT_ADV
	std::puts("PASS ext advertising capture/stop, ordered restore/failures, deferred callback persistence and generation fences, serial admission");
#else
	std::puts("PASS legacy advertising capture/stop, ordered restore/failures, deferred callback persistence and generation fences, serial admission");
#endif
}
