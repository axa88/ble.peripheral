constexpr int BLE_HS_EDONE = -18;
constexpr int pdPASS = 1;
constexpr int pdFAIL = 0;
constexpr int pdFALSE = 0;
using BaseType_t = int;
using TickType_t = unsigned;
using TimeOut_t = int;
inline TickType_t pdMS_TO_TICKS(unsigned value) { return value; }
inline void vTaskSetTimeOutState(TimeOut_t*) {}
inline int xTaskCheckForTimeOut(TimeOut_t*, TickType_t*) { return 0; }
inline void vTaskDelay(TickType_t) {}

struct FakeTimer { void (*callback)(FakeTimer*) = nullptr; bool started = false; };
using TimerHandle_t = FakeTimer*;
static bool failTimerCreate = false;
static bool failTimerStart = false;
static int liveTimers = 0;
inline TimerHandle_t xTimerCreate(const char*, TickType_t, bool, void*, void (*callback)(TimerHandle_t))
{
	if (failTimerCreate) return nullptr;
	++liveTimers;
	return new FakeTimer{ callback, false };
}
inline BaseType_t xTimerStart(TimerHandle_t timer, int)
{
	if (failTimerStart) return pdFAIL;
	timer->started = true;
	return pdPASS;
}
inline BaseType_t xTimerStop(TimerHandle_t, int) { return pdPASS; }
inline BaseType_t xTimerDelete(TimerHandle_t timer, int)
{
	if (timer) { --liveTimers; delete timer; }
	return pdPASS;
}

struct FakeSerial
{
	std::deque<int> input;
	std::vector<std::string> lines;
	int available() const { return static_cast<int>(input.size()); }
	int peek() const { return input.empty() ? -1 : input.front(); }
	int read()
	{
		if (input.empty()) return -1;
		int value = input.front();
		input.pop_front();
		return value;
	}
	void feed(char value) { input.push_back(static_cast<unsigned char>(value)); }
	void println(const char* value = "") { lines.emplace_back(value ? value : ""); }
	template <typename... Args> void printf(const char* format, Args...)
	{
		lines.emplace_back(format ? format : "");
	}
};
static FakeSerial Serial;

struct ble_npl_event;
using ble_npl_event_fn = void (*)(ble_npl_event*);
struct ble_npl_event { ble_npl_event_fn fn = nullptr; void* arg = nullptr; };
static std::deque<ble_npl_event*> nimbleEvents;
inline void ble_npl_event_init(ble_npl_event* event, ble_npl_event_fn fn, void* arg)
{
	event->fn = fn;
	event->arg = arg;
}
inline void* ble_npl_event_get_arg(ble_npl_event* event) { return event->arg; }
inline void* nimble_port_get_dflt_eventq() { return reinterpret_cast<void*>(1); }
inline int ble_npl_eventq_put(void*, ble_npl_event* event)
{
	nimbleEvents.push_back(event);
	return 0;
}
static void runOneNimbleEvent()
{
	assert(!nimbleEvents.empty());
	auto* event = nimbleEvents.front();
	nimbleEvents.pop_front();
	assert(event->fn != nullptr);
	event->fn(event);
}

static std::array<bool, 16> hostActive{};
static std::array<bool, 16> wrapperActive{};
static bool legacyActive = false;
static bool stopSucceeds = true;
static int stopCalls = 0;
inline int ble_gap_ext_adv_active(uint8_t id) { return hostActive[id] ? 1 : 0; }
#if CONFIG_BT_NIMBLE_EXT_ADV
struct NimBLEExtAdvertising
{
	bool isActive(uint8_t id) const { return wrapperActive[id]; }
	bool stop(uint8_t id)
	{
		++stopCalls;
		if (stopSucceeds) hostActive[id] = false;
		return stopSucceeds;
	}
};
#else
struct NimBLEAdvertising
{
	bool isAdvertising() const { return legacyActive; }
	bool stop()
	{
		++stopCalls;
		if (stopSucceeds) legacyActive = false;
		return stopSucceeds;
	}
};
#endif

